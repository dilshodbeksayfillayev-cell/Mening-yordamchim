# Telegram Business AI bot — environment o'zgaruvchilari.
# Bularni Vercel → loyiha → Settings → Environment Variables ga kiriting
# (har biri uchun Production belgisi qo'yilgan bo'lsin). Kiritgandan keyin Redeploy qiling.

# ===================== MAJBURIY =====================

# Bot tokeni.
# Qayerdan: Telegram → @BotFather → /mybots → botni tanlang → API Token.
# Business Mode yoqilgan bo'lsin: @BotFather → /mybots → bot → Bot Settings → Business Mode → Turn on.
TELEGRAM_BOT_TOKEN=

# Sizning (bot egasining) Telegram ID raqamingiz — faqat raqam, masalan 123456789.
# Qayerdan: Telegram → @userinfobot ga /start yozing, "Id" qatorini oling.
# (Yoki bot ishga tushgach, unga /start yozing — ID'ingizni ko'rsatadi.)
OWNER_ID=

# OpenRouter kaliti (sk-or-v1-...).
# Qayerdan: https://openrouter.ai → kirish → Keys → Create Key. Hisobda biroz kredit bo'lishi kerak.
OPENROUTER_API_KEY=

# ===================== AI =====================

# OpenRouter model ID. Bo'sh qoldirsangiz: google/gemini-3.8-flash
AI_MODEL=google/gemini-3.8-flash
# Fikrlash darajasi: low | medium | high
AI_REASONING=low

# ===================== BAZA (Supabase) =====================
# Profil tahriri, ish vaqti, chatlar ro'yxati, hisobot va bir nechta rasmdan PDF uchun kerak.
# 1) https://supabase.com → New project.
# 2) SQL Editor → New query → supabase.sql faylidagi kodni qo'yib → Run.

# Qayerdan: Supabase → Project Settings → Data API (yoki API) → Project URL.
# Ko'rinishi: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Qayerdan: Supabase → Project Settings → API Keys → "Secret keys" (sb_secret_...) → Reveal / Copy.
# Eski loyihalarda: "service_role" kaliti (eyJ... bilan boshlanadi). MAXFIY — hech kimga bermang.
SUPABASE_SERVICE_ROLE_KEY=

# ===================== XULQ-ATVOR (ixtiyoriy) =====================

# true — bot mijozga o'zi yozadi; false — javob loyihasini faqat sizga yuboradi.
AUTO_SEND=true
# true — bot chatning oxirgi 50 xabarini eslaydi; false — faqat javobsiz xabarlarni ko'radi.
# (Bot ichida ⚙️ Sozlamalar'dan ham o'zgartiriladi.)
CHAT_MEMORY=false
# Ish vaqti va hisobot uchun vaqt zonasi.
TZ_NAME=Asia/Tashkent
# Mijoz ketma-ket yozsa, javobdan oldin necha millisekund kutish.
DEBOUNCE_MS=5000
# Suhbat sizga uzatilganda bot o'sha chatda necha soat jim turadi.
HANDOFF_HOURS=12

# ===================== CRON (ixtiyoriy) =====================
# Istalgan uzun tasodifiy matn. Berilsa, kunlik hisobot (/api/report) faqat Vercel Cron'dan ishlaydi.
CRON_SECRET=
